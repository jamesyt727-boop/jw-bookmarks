{
  "manifest_version": 3,
  "name": "JW Bookmarks",
  "version": "1.4.0",
  "key": "",
  "description": "收藏时自动归位到正确文件夹：本地规则 → Jev 决策 → DeepSeek 兜底。by JamesWu",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["bookmarks", "storage", "contextMenus", "activeTab"],
  "host_permissions": [
    "https://api.typesafe.ai/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JW Bookmarks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
